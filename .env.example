# TastyTrip 환경 변수 견본
#
# 이 파일은 "어떤 값이 필요한지" 만 적어 둔 것으로, 값은 비워 둡니다.
# 실제 값은 .env.local 에 적고, .env.local 은 절대 깃에 올리지 않습니다.
# 배포할 때는 파일을 올리지 말고 호스팅 서비스의 환경 변수 화면에 입력하세요.

# ── AI 분석 ───────────────────────────────────────────────
# Google AI Studio 에서 발급. 결제 계정을 붙이지 않으면 요금이 청구되지 않습니다.
GEMINI_API_KEY=

# ── 로그인 ────────────────────────────────────────────────
# 아무 문자열이나 길게. 유출되면 남이 로그인 토큰을 위조할 수 있으니 배포용은 새로 만드세요.
JWT_SECRET=
# 구글 로그인 클라이언트 ID. 공개되어도 되는 값입니다.
GOOGLE_OAUTH_CLIENT_ID=

# ── 데이터베이스 ──────────────────────────────────────────
# Turso. 배포 시 필수입니다. 없으면 재시작할 때 데이터가 사라집니다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── 지도 ──────────────────────────────────────────────────
# [서버 전용] 식당 검색·상세조회(Places API). 브라우저로 절대 나가지 않습니다.
#   Cloud Console 에서 'API 제한 → Places API' 로 좁혀 두세요.
GOOGLE_MAPS_API_KEY=
# [공개됨] 지도 그리기(Maps JavaScript API). 접속자 누구나 볼 수 있습니다.
#   반드시 위와 다른 키를 쓰고, 'HTTP 리퍼러 제한' 에 배포 도메인만 등록하세요.
#   비워 두면 지도 대신 목록 보기로 동작합니다.
GOOGLE_MAPS_BROWSER_KEY=

# ── 공공 데이터 ───────────────────────────────────────────
# 공공데이터포털에서 발급. '디코딩' 된 키를 넣으세요(%2F 같은 문자가 없는 쪽).
MFDS_SERVICE_KEY=
USDA_API_KEY=

# ── 이미지 검색 ───────────────────────────────────────────
# Pexels. 서버에서만 쓰므로 VITE_ 접두사를 붙이면 안 됩니다.
PEXELS_API_KEY=

# ── 운영 ──────────────────────────────────────────────────
# 공개 데이터 동기화 엔드포인트 보호용. 운영 환경에서 비우면 해당 기능이 차단됩니다.
ADMIN_TOKEN=
# 분당 허용 요청 수 (메뉴 분석 등 유료 호출 보호). 0 이면 제한 없음.
RATE_LIMIT_PER_MINUTE=20
